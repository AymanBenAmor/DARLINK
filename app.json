{
  "expo": {
    "name": "DARLINK",
    "slug": "SmartHome",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon_app.png",
    "scheme": "smarthome",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.abenamor.smarthome",
      "icon": "./assets/images/icon_app.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#101827",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.abenamor.smarthome",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon_app.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101827",
          "image": "./assets/images/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "bluetoothAlwaysPermission": "Allow DARLINK to connect to nearby ESP32 controllers."
        }
      ],
      "expo-audio",
      "expo-asset",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d17b50d9-313c-4e51-a4f3-5312cb27add6"
      }
    }
  }
}
